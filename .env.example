# ---- Claude (required for the assistant, intake, hours parsing, mail triage) ----
ANTHROPIC_API_KEY=sk-ant-...
# DELOREAN_MODEL=claude-opus-5-5
# DELOREAN_TRIAGE_MODEL=claude-haiku-5-5

# ---- Server ----
PORT=8787
PUBLIC_URL=https://delorean.therefinery.tv     # used in magic links and Google webhooks
# DB_PATH=./server/data/delorean.db
# SEED_DEMO=1                                  # demo people/rooms/jobs on first run
# DELOREAN_SCHEDULER=0                         # disable the bots' heartbeat

# ---- Xero (Settings → Xero → Connect) ----
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://delorean.therefinery.tv/api/settings/xero/callback

# ---- Google Workspace (service account with domain-wide delegation) ----
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/delorean/google-sa.json   # or the JSON itself
GOOGLE_WORKSPACE_DOMAIN=therefinery.tv
GOOGLE_DELEGATED_ADMIN=alastair@therefinery.tv   # owns room/kit resource calendars
GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/delorean-gmail
# GOOGLE_WATCH_MAILBOXES=bookings@therefinery.tv,accounts@therefinery.tv  # shared inboxes to watch too
# GOOGLE_CHAT_SPACE=spaces/AAAA...               # ops room for bot announcements
# GOOGLE_WEBHOOK_SECRET=change-me                # append ?secret=... to the Pub/Sub + Chat endpoint URLs
# DELOREAN_MAILBOX=delorean@therefinery.tv       # sender for email nudges
