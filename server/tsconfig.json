{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true, "types": ["node"], "esModuleInterop": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"]
}